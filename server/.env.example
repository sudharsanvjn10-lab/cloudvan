# Database Connection URL (e.g. Aiven, Render, AWS RDS)
DATABASE_URL=mysql://username:password@hostname:3306/databasename
PORT=3000

# Security: Mandatory JWT secret (MUST be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production

# Database TLS is required when NODE_ENV=production.
# Set a CA for providers that use a private certificate authority.
# DB_CA_PATH=/etc/ssl/certs/aiven-ca.pem
# DB_CA_CERT=
# DB_SSL=true

# Optional First-Time Explicit SuperAdmin Bootstrap
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=YourStrongPasswordHere

# Optional CORS Extra Allowed Origins (Comma-separated)
# CORS_ALLOWED_ORIGINS=https://your-custom-domain.com

# SMTP Mailing Configuration (e.g. Gmail or Hostinger SMTP)
# If left blank, server falls back to secure masked mock logging in console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
